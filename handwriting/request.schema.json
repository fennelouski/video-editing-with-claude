{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clauto handwriting generation request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "clauto.handwriting.generation-request"
    },
    "requestID": {
      "type": "string"
    },
    "exactText": {
      "type": "string"
    },
    "exactTextUTF8SHA256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "locale": {
      "type": "string"
    },
    "prompt": {
      "type": "string"
    },
    "requestedProvider": {
      "type": "string"
    },
    "status": {
      "const": "awaitingProvider"
    },
    "approval": {
      "const": "draft"
    },
    "providerBoundary": {
      "type": "string"
    },
    "capability": {
      "type": "string"
    },
    "nextAction": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "transparentBackground": {
      "const": true
    },
    "sourceStyleID": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "kind",
    "requestID",
    "exactText",
    "exactTextUTF8SHA256",
    "locale",
    "prompt",
    "requestedProvider",
    "status",
    "approval",
    "providerBoundary",
    "capability",
    "nextAction",
    "schemaVersion",
    "transparentBackground"
  ]
}
